{
  "name": "apply-bot",
  "productName": "Apply Bot",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "postinstall": "node scripts/prepare-app.js",
    "dev": "node scripts/prepare-app.js && electron -r esbuild-register main.ts",
    "build": "esbuild main.ts preload.ts --bundle --platform=node --format=esm --target=node20 --external:electron --outdir=dist",
    "package": "electron-packager . \"Apply Bot\" --overwrite --out=release-builds --extra-resource=../dist/api-server --icon=assets/icon",
    "preview": "node scripts/prepare-app.js && PREVIEW=1 electron -r esbuild-register main.ts"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^26.2.0",
    "electron": "^43.4.0",
    "esbuild": "^0.28.2",
    "esbuild-register": "^3.6.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "get-port": "^7.2.0"
  }
}
